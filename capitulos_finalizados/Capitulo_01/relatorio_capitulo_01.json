      "pitch_semitones": 0
    },
    {
      "id": "cena_01_fala_003",
      "character": "Narrador",
      "exact_text": "Um cachorro está se afogando.",
      "start_seconds": 10.709187500000002,
      "end_seconds": 12.52035416666667,
      "duration_seconds": 1.8111666666666666,
      "voice_id": "4XmhZ74tBbUVCXIYNMMo",
      "source_file": "/workspace/dublagem_jesus/audio/cena_01/cena_01_fala_003_narrador.mp3",
