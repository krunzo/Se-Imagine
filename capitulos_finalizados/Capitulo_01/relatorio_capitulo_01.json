      "pitch_semitones": 0
    },
    {
      "id": "cena_01_fala_005",
      "character": "Narrador",
      "exact_text": "Mas você não consegue simplesmente virar as costas.",
      "start_seconds": 15.76035416666667,
      "end_seconds": 19.10404166666667,
      "duration_seconds": 3.3436875,
      "voice_id": "4XmhZ74tBbUVCXIYNMMo",
