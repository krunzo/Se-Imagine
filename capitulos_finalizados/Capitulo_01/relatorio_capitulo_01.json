    },
    {
      "id": "cena_01_fala_002",
      "character": "Narrador",
      "exact_text": "Enquanto todos procuram um lugar seguro, você escuta algo em meio ao barulho da chuva.",
      "start_seconds": 4.289958333333334,
      "end_seconds": 9.909187500000002,
      "duration_seconds": 5.619229166666667,
      "voice_id": "4XmhZ74tBbUVCXIYNMMo",
