      "reverb_preservado": false
    },
    {
      "id": "cena_22_fala_002",
      "personagem": "Protagonista",
      "texto_exato": "Curei pessoas, alimentei famílias, salvei vidas...",
      "inicio_segundos": 3.45,
      "fim_fala_segundos": 7.77,
      "fim_cauda_segundos": 7.77,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_22_fala_003",
      "personagem": "Protagonista",
      "texto_exato": "E mesmo assim, eles me odiaram.",
      "inicio_segundos": 8.0,
      "fim_fala_segundos": 10.64,
      "fim_cauda_segundos": 10.64,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_22_fala_004",
      "personagem": "Deus",
      "texto_exato": "O mal faz ruído. O bem, muitas vezes, acontece em silêncio.",
      "inicio_segundos": 13.34,
      "fim_fala_segundos": 18.78,
      "fim_cauda_segundos": 20.819979166666666,
      "voice_id": "hwnuNyWkl9DjdTFykrN6",
      "pitch_fonte": -1,
      "reverb_preservado": true
    },
    {
      "id": "cena_22_fala_005",
      "personagem": "Deus",
      "texto_exato": "Não confunda aquilo que grita alto com aquilo que possui maior valor.",
      "inicio_segundos": 20.38,
      "fim_fala_segundos": 24.86,
      "fim_cauda_segundos": 26.899979166666668,
      "voice_id": "hwnuNyWkl9DjdTFykrN6",
      "pitch_fonte": -1,
      "reverb_preservado": true
    },
    {
      "id": "cena_22_fala_006",
      "personagem": "Protagonista",
      "texto_exato": "Mesmo sem poderes... eles arriscaram tudo por pessoas que nem conheciam.",
      "inicio_segundos": 26.76,
      "fim_fala_segundos": 32.04,
      "fim_cauda_segundos": 32.04,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_22_fala_007",
      "personagem": "Protagonista",
      "texto_exato": "Mas as pessoas também são capazes de tanta crueldade...",
      "inicio_segundos": 32.44,
      "fim_fala_segundos": 36.2,
      "fim_cauda_segundos": 36.2,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_22_fala_008",
      "personagem": "Deus",
      "texto_exato": "A liberdade que permite a crueldade é a mesma que torna a compaixão possível.",
      "inicio_segundos": 37.5,
      "fim_fala_segundos": 42.78,
      "fim_cauda_segundos": 44.81997916666667,
      "voice_id": "hwnuNyWkl9DjdTFykrN6",
      "pitch_fonte": -1,
      "reverb_preservado": true
    },
    {
      "id": "cena_22_fala_009",
