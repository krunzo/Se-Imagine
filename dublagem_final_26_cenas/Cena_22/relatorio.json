      "personagem": "Protagonista",
      "texto_exato": "Eu só queria ajudar...",
      "inicio_segundos": 1.62,
      "fim_fala_segundos": 3.22,
      "fim_cauda_segundos": 3.22,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
