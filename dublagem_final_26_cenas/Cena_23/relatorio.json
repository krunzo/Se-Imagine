      "fim_cauda_segundos": 21.03,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_23_fala_005",
      "personagem": "Protagonista",
      "texto_exato": "Só para que eles tivessem mais uma chance.",
      "inicio_segundos": 21.26,
      "fim_fala_segundos": 23.82,
      "fim_cauda_segundos": 23.82,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_23_fala_006",
