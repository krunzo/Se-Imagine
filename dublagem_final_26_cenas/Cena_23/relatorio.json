  "dialogos": [
    {
      "id": "cena_23_fala_001",
      "personagem": "Protagonista",
      "texto_exato": "Como faço para salvar o mundo?",
      "inicio_segundos": 1.62,
      "fim_fala_segundos": 3.94,
      "fim_cauda_segundos": 3.94,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
      "pitch_fonte": 0,
      "reverb_preservado": false
    },
    {
      "id": "cena_23_fala_002",
      "personagem": "Deus",
      "texto_exato": "O equilíbrio não conta quantas escolhas foram feitas. Ele responde ao peso de cada uma.",
      "inicio_segundos": 7.14,
      "fim_fala_segundos": 13.22,
      "fim_cauda_segundos": 15.259979166666668,
      "voice_id": "hwnuNyWkl9DjdTFykrN6",
      "pitch_fonte": -1,
      "reverb_preservado": true
    },
    {
      "id": "cena_23_fala_003",
      "personagem": "Protagonista",
      "texto_exato": "Se eu pudesse... entregaria todos os meus poderes.",
      "inicio_segundos": 15.12,
      "fim_fala_segundos": 19.44,
      "fim_cauda_segundos": 19.44,
      "voice_id": "CstacWqMhJQlnfLPxRG4",
